/* ── Reset & Base ───────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:           #0d1114;
  --bg2:          #111619;
  --surface:      #161c20;
  --surface2:     #1c2428;
  --border:       #242d33;
  --text:         #e4eaed;
  --muted:        #7d9099;
  --faint:        #445560;
  --accent:       #6e93a8;
  --accent-light: #90b8ce;
  --accent-dim:   rgba(110,147,168,0.12);
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  line-height: 1.7;
  font-size: 16px;
}

a { color: var(--accent-light); text-decoration: none; }
a:hover { text-decoration: underline; }

/* ── Nav ────────────────────────────────────────────────────────── */
nav {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding: 0 2.5rem;
  height: 56px;
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  background: rgba(13,17,20,0.92);
  backdrop-filter: blur(10px);
  z-index: 100;
}

nav .logo {
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.05em;
  color: var(--accent-light);
  margin-right: auto;
}

nav ul {
  display: flex;
  gap: 1.75rem;
  list-style: none;
}

nav ul a {
  color: var(--muted);
  font-size: 0.82rem;
  letter-spacing: 0.02em;
  transition: color 0.15s;
}
nav ul a:hover { color: var(--text); text-decoration: none; }

.btn-sm {
  font-size: 0.8rem;
  padding: 0.35rem 0.9rem;
  border: 1px solid var(--border);
  border-radius: 5px;
  color: var(--muted);
  white-space: nowrap;
  transition: border-color 0.2s, color 0.2s;
}
.btn-sm:hover { border-color: var(--accent); color: var(--accent-light); text-decoration: none; }

/* ── Hero ───────────────────────────────────────────────────────── */
#hero {
  position: relative;
  height: calc(100vh - 56px);
  min-height: 520px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}

#globe-canvas {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  cursor: grab;
}

#globe-canvas:active {
  cursor: grabbing;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(to right, rgba(10,13,18,0.92) 38%, rgba(10,13,18,0.3) 65%, transparent 100%);
}

#geo-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

#geo-svg .geo-coord {
  font-family: 'Courier New', monospace;
  font-size: 10px;
  fill: var(--faint);
}

.pt {
  animation: ptpulse 2.8s ease-in-out infinite;
}
.pt:nth-child(2) { animation-delay: 0.5s; }
.pt:nth-child(3) { animation-delay: 1.0s; }
.pt:nth-child(4) { animation-delay: 1.5s; }
.pt:nth-child(5) { animation-delay: 0.2s; }
.pt:nth-child(6) { animation-delay: 1.8s; }
.pt:nth-child(7) { animation-delay: 0.8s; }

@keyframes ptpulse {
  0%, 100% { opacity: 1;   r: 3.5; }
  50%       { opacity: 0.2; r: 2; }
}

#hero-content {
  position: relative;
  z-index: 1;
  padding: 2.5rem 3rem 4rem;
  max-width: 760px;
}

.hero-label {
  font-size: 0.9rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.6rem;
}

#hero-content h1 {
  font-size: clamp(2.8rem, 6vw, 4.2rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 1rem;
}

.accent { color: var(--accent-light); }

.tagline {
  font-size: 1.2rem;
  color: var(--muted);
  max-width: 560px;
  margin-bottom: 2rem;
}

.hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

.btn {
  display: inline-block;
  padding: 0.6rem 1.4rem;
  background: var(--accent);
  color: #0d1114;
  font-weight: 600;
  font-size: 0.88rem;
  border-radius: 6px;
  transition: opacity 0.2s;
}
.btn:hover { opacity: 0.88; text-decoration: none; }

.btn-ghost {
  display: inline-block;
  padding: 0.6rem 1.4rem;
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 0.88rem;
  border-radius: 6px;
  transition: border-color 0.2s, color 0.2s;
}
.btn-ghost:hover { border-color: var(--accent); color: var(--accent-light); text-decoration: none; }

/* ── Section base ───────────────────────────────────────────────── */
section:not(#hero) {
  max-width: 920px;
  margin: 0 auto;
  padding: 5rem 2.5rem;
  border-bottom: 1px solid var(--border);
}

section:last-of-type { border-bottom: none; }

.section-label {
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 0.6rem;
}

h2 {
  font-size: 1.7rem;
  font-weight: 600;
  margin-bottom: 2rem;
}

h3 { font-size: 1.05rem; font-weight: 600; }

.section-intro {
  color: var(--muted);
  max-width: 580px;
  margin-bottom: 2.5rem;
  margin-top: -1.2rem;
}

/* ── About ──────────────────────────────────────────────────────── */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 4rem;
  align-items: start;
}

.about-text h2 {
  font-size: 1.35rem;
  font-weight: 500;
  line-height: 1.4;
  color: var(--text);
  margin-bottom: 1.4rem;
}

.about-text p {
  color: var(--muted);
  margin-bottom: 1rem;
  font-size: 0.95rem;
}

.about-meta {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
}

.meta-item { display: flex; flex-direction: column; gap: 0.15rem; }
.meta-label {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--faint);
}
.meta-item span:last-child { font-size: 0.88rem; color: var(--text); }

/* ── Timeline (Experience) ───────────────────────────────────────── */
.timeline { display: flex; flex-direction: column; gap: 2.5rem; }

.timeline-item {
  padding: 1.75rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: border-color 0.2s;
}
.timeline-item:hover { border-color: var(--accent); }

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
  gap: 1rem;
}

.timeline-date {
  font-size: 0.78rem;
  color: var(--muted);
  white-space: nowrap;
  margin-top: 0.15rem;
}

.company {
  display: block;
  font-size: 0.82rem;
  color: var(--accent);
  margin-top: 0.2rem;
}

.exp-bullets {
  list-style: none;
  margin-bottom: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.exp-bullets li {
  font-size: 0.9rem;
  color: var(--muted);
  padding-left: 1.2rem;
  position: relative;
}
.exp-bullets li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-size: 0.8rem;
}

.exp-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }

/* ── Project cards ───────────────────────────────────────────────── */
.project-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 1.5rem;
  transition: border-color 0.2s, transform 0.18s;
}
.card:hover { border-color: var(--accent); transform: translateY(-3px); }

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.75rem;
}

.card-links { display: flex; gap: 0.8rem; font-size: 0.8rem; }

.card p { color: var(--muted); font-size: 0.88rem; margin-bottom: 1.1rem; }

.project-video {
  margin-bottom: 1.1rem;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--border);
}

.project-video video {
  width: 100%;
  display: block;
  background: var(--surface2);
}

.tags { display: flex; gap: 0.45rem; flex-wrap: wrap; }
.tags span {
  font-size: 0.72rem;
  padding: 3px 10px;
  border: 1px solid var(--border);
  border-radius: 99px;
  color: var(--muted);
  background: var(--surface2);
}

/* ── GIS & Research (Map Gallery) ───────────────────────────────── */
.map-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

.map-tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid var(--border);
  background: var(--bg2);
  transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  cursor: pointer;
  min-height: 250px;
}

.map-tile:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
}

.map-tile img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
  background: var(--bg2);
}

.map-tile-placeholder {
  width: 100%;
  min-height: 250px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--surface2);
  color: var(--faint);
}

.map-tile-placeholder span {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--accent);
}

.map-tile-placeholder p {
  font-size: 0.75rem;
  color: var(--faint);
  font-family: 'Courier New', monospace;
}

.map-tile-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1.2rem 1rem 1rem;
  background: linear-gradient(to top, rgba(13,17,20,0.95) 0%, rgba(13,17,20,0.85) 70%, transparent 100%);
  opacity: 0;
  transition: opacity 0.25s;
}

.map-tile:hover .map-tile-overlay {
  opacity: 1;
}

.map-tile-overlay h3 {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text);
  line-height: 1.3;
}

/* Empty map tiles (placeholders) */
.map-tile-empty {
  pointer-events: none;
  opacity: 0.5;
}

.map-tile-empty:hover {
  transform: none;
  border-color: var(--border);
}

/* ── Map Modal ──────────────────────────────────────────────────── */
.modal {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 1000;
  overflow-y: auto;
}

.modal.active {
  display: block;
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(4px);
  animation: fadeIn 0.2s ease;
}

.modal-content {
  position: relative;
  max-width: 1000px;
  width: 90%;
  margin: 3rem auto;
  padding: 1.5rem;
  animation: slideUp 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-close {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 2rem;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  z-index: 10;
  line-height: 1;
  padding: 0;
}

.modal-close:hover {
  background: var(--surface2);
  border-color: var(--accent);
  color: var(--text);
}

.modal-body {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.modal-image {
  background: var(--bg2);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  max-height: 65vh;
}

.modal-image img {
  width: 100%;
  height: auto;
  max-height: 65vh;
  object-fit: contain;
  display: block;
}

.modal-details {
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.modal-details h2 {
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--text);
  margin: 0;
  line-height: 1.3;
}

.modal-details p {
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.6;
  margin: 0;
}

.modal-btn {
  margin-top: auto;
  align-self: flex-start;
}

@media (max-width: 768px) {
  .modal-content {
    margin: 1rem;
    padding: 0.5rem;
    width: calc(100% - 2rem);
  }

  .modal-image {
    padding: 1rem;
    max-height: 55vh;
  }

  .modal-image img {
    max-height: 55vh;
  }
}

/* ── Skills ─────────────────────────────────────────────────────── */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 2rem;
}

.skill-group h4 {
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 1rem;
}

.skill-group ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
.skill-group li {
  font-size: 0.9rem;
  color: var(--muted);
  padding: 0.4rem 0.85rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 6px;
  transition: border-color 0.15s, color 0.15s;
}
.skill-group li:hover { border-color: var(--accent); color: var(--text); }

/* ── Campus & Leadership ────────────────────────────────────────── */
.campus-grid { display: flex; flex-direction: column; gap: 1.5rem; }

.campus-card {
  display: flex;
  gap: 1.5rem;
  align-items: flex-start;
  padding: 1.5rem;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  transition: border-color 0.2s;
}
.campus-card:hover { border-color: var(--accent); }

.campus-icon {
  width: 44px;
  height: 44px;
  min-width: 44px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  color: var(--accent-light);
}

.campus-card h3 { margin-bottom: 0.2rem; }
.campus-card .company { margin-bottom: 0.6rem; }
.campus-card p { font-size: 0.88rem; color: var(--muted); }

/* ── Contact ────────────────────────────────────────────────────── */
#contact { text-align: center; }
#contact h2 { margin-bottom: 0.75rem; }

.contact-intro {
  color: var(--muted);
  font-size: 0.95rem;
  max-width: 480px;
  margin: 0 auto 2rem;
}

.contact-email {
  display: inline-block;
  font-size: 1.2rem;
  color: var(--accent-light);
  margin-bottom: 2rem;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.2rem;
}

.social-links { display: flex; gap: 2rem; justify-content: center; }
.social-links a { color: var(--muted); font-size: 0.9rem; transition: color 0.15s; }
.social-links a:hover { color: var(--text); text-decoration: none; }

/* ── Footer ─────────────────────────────────────────────────────── */
footer {
  text-align: center;
  padding: 2rem;
  font-size: 0.78rem;
  color: var(--faint);
  border-top: 1px solid var(--border);
}
footer a { color: var(--faint); }
footer a:hover { color: var(--muted); }

/* ── Scroll reveal ──────────────────────────────────────────────── */
.reveal {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}
.reveal.visible { opacity: 1; transform: translateY(0); }

/* ── Responsive ─────────────────────────────────────────────────── */
@media (max-width: 720px) {
  nav ul { display: none; }
  #hero-content { padding: 2rem 1.5rem 3rem; }
  section:not(#hero) { padding: 3.5rem 1.5rem; }
  .about-grid { grid-template-columns: 1fr; gap: 2rem; }
  .timeline-header { flex-direction: column; }
  .skills-grid { grid-template-columns: 1fr 1fr; }
}